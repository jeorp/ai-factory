PROVIDER=demo
# 固定GitHubデモでも実際のGeminiを使う: AI_PROVIDER=gemini
AI_PROVIDER=demo
# 画面のモデル選択肢（カンマ区切り、先頭が既定）。Proは無料枠なし。
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-pro-preview
# 実接続: PROVIDER=live。GitHub AppのClient ID / secretを設定。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# 本番: openssl rand -base64 32 で生成しSecret Managerへ登録。
COOKIE_KEY=
OPENAI_MODELS=gpt-5-mini
